{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // DOM is here for the browser types a transport cannot avoid naming:
    // RTCIceServer and the data-channel types in mesh.ts and connect.ts, URL
    // in ref.ts. Everything the lockstep driver touches must stay
    // Node-runnable.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/test"]
}
