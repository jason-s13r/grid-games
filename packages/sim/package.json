{
  "name": "@tessera/sim",
  "version": "0.1.0",
  "description": "Deterministic Empire Attack simulation core. The state hash is the compatibility contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "tessera-replay": "./dist/replay.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node dist/replay.js --selftest",
    "replay": "pnpm build && node dist/replay.js"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5"
  }
}
