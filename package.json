{
  "name": "tessera",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @tessera/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "replay": "pnpm --filter @tessera/sim replay",
    "clean": "rm -rf apps/*/dist packages/*/dist .parcel-cache apps/*/.parcel-cache"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
