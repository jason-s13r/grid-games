{
  "name": "@tessera/worker",
  "version": "0.0.0",
  "private": true,
  "description": "The Cloudflare Worker: serves the web client, creates games, and hosts each game room in a Durable Object.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "watch": "wrangler dev --port 8787",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tessera/protocol": "workspace:*",
    "@tessera/room": "workspace:*",
    "@tessera/sim": "workspace:*",
    "@tessera/web": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.6.3",
    "wrangler": "4.148.0"
  }
}
