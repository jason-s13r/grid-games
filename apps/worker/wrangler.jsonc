{
  // One Worker serves everything at tessera.qot.nz: the web client as static
  // assets, the API under /api, and each game's WebSocket under /game/:id.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tessera",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "assets": {
    // Built by apps/web. `pnpm dev` and `pnpm build` produce it first.
    "directory": "../web/dist",
    "binding": "ASSETS",
    // /g/<room> is a page of the client, not a file.
    "not_found_handling": "single-page-application",
    // The API and the game sockets reach the Worker; everything else is served
    // straight from the assets.
    "run_worker_first": ["/api/*", "/game/*"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameRoom" },
      // Two devices meeting to move a player across. Keeps nothing.
      { "name": "PAIRS", "class_name": "Pairing" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Pairing"] }
  ],

  // Listings, players and results. No database_id: `wrangler deploy` creates
  // the database on first deploy and binds it. The schema is in migrations/,
  // applied by `pnpm deploy` after the Worker is up, and locally by `pnpm dev`.
  "d1_databases": [{ "binding": "DB", "database_name": "tessera", "migrations_dir": "migrations" }],

  // Finished games, whole, for replays. Wrangler creates the database on
  // deploy but expects the bucket to exist, so `pnpm deploy` creates it first
  // (and carries on if it already exists). A room deletes its own storage
  // KEEP_DAYS after archiving.
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "tessera-archive" }],

  // Settings that change without a rebuild are Worker variables set in the
  // Cloudflare dashboard, and kept across deploys:
  //   DEFAULT_DURATION_MINUTES  the game length the forms offer first, and
  //                             what a create request without one gets
  //                             (15 when unset; 14400 is ten days)
  //   TIP_URL                   where "Support the game" goes (the maker's
  //                             Ko-fi page when unset), or "off" for none
  "keep_vars": true,
  "vars": {
    // How long a finished game's room keeps its storage once it is archived.
    "KEEP_DAYS": "30"
  },

  "observability": { "enabled": true }
}
