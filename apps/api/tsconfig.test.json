{
  // The build excludes src/test so no test code reaches dist. Typechecking
  // still has to see it, so this config puts it back and emits nothing.
  //
  // `rootDir` is dropped rather than widened: `archives.test.ts` reads the web
  // client's own `fetchArchive`, because the thing worth proving is that the
  // shipped client can read what this service serves — a hand-written fetch
  // beside it would prove only that this file agrees with itself. Nothing in
  // `src` outside the tests imports across an app, so the build's rootDir is
  // untouched and dist stays what it was.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": null
  },
  "include": ["src"],
  "exclude": []
}
