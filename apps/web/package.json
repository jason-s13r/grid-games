{
  "name": "@tessera/web",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "source": [
    "index.html",
    "about.html",
    "privacy.html"
  ],
  "scripts": {
    "dev": "parcel",
    "build": "parcel build --public-url /",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "watch": "parcel watch --public-url / --no-hmr"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.2.7",
    "@tessera/protocol": "workspace:*",
    "@tessera/room": "workspace:*",
    "@tessera/sim": "workspace:*",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.16.4",
    "@vitest/browser": "3.2.7",
    "parcel": "2.16.4",
    "playwright": "1.62.1",
    "typescript": "5.6.3"
  }
}
